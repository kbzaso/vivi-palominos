---
import { Image } from "astro:assets";

const { specificClass, content, loading } = Astro.props;
---

<div class={`feature-card reveal-up z-10 relative w-full lg:max-w-[500px] ${specificClass}`}>
  <Image
    src={content.image}
    alt={content.alt ?? ""}
    class="feature-card__image h-70 object-cover w-full rounded-lg shadow-md"
    width={500}
    height={500}
    loading={loading}
  />
  <div class="relative">
    <Image
      src={content.svg}
      alt=""
      aria-hidden="true"
      class="absolute top-4 md:hidden block"
      width={38}
      height={320}
      loading={"lazy"}
    />
    <div class="pl-12 md:pl-0 text-(--color-night-500)">
      <h2 class="font-travel text-3xl py-4 mt-2 bg-[var(--color-cloud)]">
        {content.title}
      </h2>
      <p class="text-lg text-pretty">
        {content.text}
      </p>
    </div>
  </div>
</div>

<style>
  p{
    margin-block: 1em;
  }
</style>