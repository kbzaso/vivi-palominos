---
import { Image } from "astro:assets";
import Nav from "./Nav.astro";
import { Phone, ArrowRight, Plane } from "@lucide/astro";
import Copied from "./Copied";

type AgentInfo = {
  name: string;
  photo: string;
  email: string;
  phone: string;
};

type Info = {
  title: string;
  description: string;
  image: string;
  url: string;
  cta: string;
  ctaWsp: string;
  agent: AgentInfo;
};

const info: Info = {
  title: "Viaja con confianza, explora con facilidad",
  description: "Agente de viajes",
  image: "/hero-big.jpg",
  url: "https://vivipalominos.com",
  cta: "Planifica tu viaje ahora",
  ctaWsp: "https://wa.me/56999974471",
  agent: {
    name: "Viviana Palominos",
    photo: "/vivi.webp",
    email: "vivi@vivipalominos.com",
    phone: "+569 9997 4471",
  },
};
---

<section class="min-w-[320px]">
  <Nav url={info.ctaWsp} />
  <header class="relative w-full mx-auto">
    <Image
      src="/hero-big.webp"
      alt=""
      class="xl:h-[550px] h-[500px] md:h-[500px] w-full object-cover"
      width={1000}
      height={1000}
      loading={"eager"}
    />
    <!-- AGENT + TEXT -->
    <div
      class="absolute md:top-[200px] top-[350px] px-4 z-10 w-full max-w-6xl left-1/2 transform -translate-x-1/2"
    >
      <!-- AIRPLAIN -->
      <Image
        src="/airplain.webp"
        class="airplain-float absolute z-10 w-80 right-10 md:right-20 -top-[16.5rem] md:-top-[7.5rem]"
        alt=""
        aria-hidden="true"
        width={1000}
        height={1000}
        loading={"eager"}
      />
      <div
        class="flex flex-col md:space-x-8 md:flex-row md:items-end -mt-20 md:mt-20 w-full"
      >
        <figure
          class="enter relative h-56 w-48 md:h-96 md:w-56 self-center md:self-start shrink-0"
          style="--enter-delay: 200ms"
        >
          <Image
            src="/vivi.webp"
            alt={info.agent.name}
            class="h-full w-full object-cover object-top shadow-xl rounded-lg"
            width={1000}
            height={1000}
            loading={"eager"}
          />
          <div
            aria-hidden="true"
            class="absolute inset-x-0 bottom-0 h-1/2 rounded-b-lg bg-gradient-to-t from-black/80 via-black/40 to-transparent"
          ></div>
          <figcaption
            class="absolute inset-x-0 bottom-0 px-4 pb-3 text-white"
          >
            <p class="text-[0.65rem] uppercase tracking-[0.2em] font-semibold text-white/80">
              Agente de viajes
            </p>
            <p class="font-travel text-2xl md:text-3xl leading-tight mt-0.5">
              {info.agent.name}
            </p>
          </figcaption>
        </figure>
        <div class="flex flex-col w-full">
          <p
            class="enter hidden md:block text-[0.7rem] uppercase tracking-[0.22em] font-semibold text-[var(--color-night)]/60 self-start"
            style="--enter-delay: 280ms"
          >
            30+ años creando viajes inolvidables
          </p>
          <h1
            class="enter font-travel mt-4 md:mt-3 text-5xl md:text-6xl md:max-w-[820px] lg:text-7xl text-pretty md:text-balance text-center md:text-left max-w-xl self-center md:self-start md:leading-[0.98] text-(--color-night-500)"
            style="--enter-delay: 320ms"
          >
            {info.title}
          </h1>
          <div
            class="enter mt-5 flex gap-2 flex-col sm:gap-5 sm:flex-row items-center md:items-start self-center md:self-start"
            style="--enter-delay: 440ms"
          >
            <Copied value={info.agent.email} client:load/>
            <span aria-hidden="true" class="hidden sm:inline text-[var(--color-night)]/30 self-center">•</span>
            <a
              href={`tel:${info.agent.phone.replace(/\s+/g, "")}`}
              class="link-soft text-lg underline global-focus flex gap-2 rounded-xs text-gray-700 self-center"
              ><Phone /> {info.agent.phone}</a
            >
          </div>
          <a
            href="#contact-form"
            class="enter global-button w-full mt-6 md:mt-7 py-4 text-xl global-focus flex items-center justify-center gap-2 md:max-w-xs font-travel text-(--color-night-500) bg-(--color-water-300) hover:bg-(--color-water) hover:scale-105 transition"
            style="--enter-delay: 560ms"
            ><span>{info.cta}</span><Plane class="size-5" aria-hidden="true" /></a
          >
        </div>
      </div>
    </div>
    <!-- SEPARATOR DESKTOP -->
    <div class="absolute right-0 z-0 top-56 hidden w-full md:block">
      <Image
        src="/separator.svg"
        class="w-full object-cover z-0"
        alt=""
        aria-hidden="true"
        width={1000}
        height={1000}
        loading={"eager"}
      />
    </div>
    <!-- SEPARATOR MOBILE -->
    <div class="w-full top-44 absolute md:hidden">
      <!-- This image is decorative and serves as a visual separator -->
      <Image
        src="/separator-sm.svg"
        class="w-full object-cover z-0"
        alt=""
        aria-hidden="true"
        width={1000}
        height={1000}
        loading={"eager"}
      />
    </div>
  </header>
</section>
